# Example keystore.properties file for local release signing
# Copy this file to `keystore.properties` (which is gitignored) and fill in your values.
# Alternatively, configure these as environment variables in CI/CD or local shell.

# Path to the keystore file (.jks or .keystore) - relative to root project or absolute
release.keystore.path=release.jks

# Keystore password
release.keystore.password=your_keystore_password_here

# Key alias
release.key.alias=your_key_alias_here

# Key password (optional, defaults to keystore password if same)
release.key.password=your_key_password_here
